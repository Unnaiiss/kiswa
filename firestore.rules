rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isStaffOrAdmin() {
      return hasRole('admin') || hasRole('staff');
    }

    // Public can read active products; staff/admin can read all products
    // (including pending/inactive ones) for the admin panel. All writes go
    // through server code using firebase-admin, which bypasses these rules.
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow write: if false;
    }

    // Only Admin pages (app/admin/**, gated to role=='admin' at the session
    // layer) ever read these three collections — /pos never queries them
    // (it only reads products/combos). isStaffOrAdmin() here would grant a
    // staff account direct-SDK read access (sales PII, stock audit trail)
    // that no legitimate staff-facing feature uses, so this is admin-only.
    match /stockMovements/{movementId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // Admin can read every sale; a signed-in customer may additionally read
    // ONLY their own (resource.data.customerUid == their uid) — this is the
    // real security boundary behind /account/orders and /account/orders/
    // [id] (which read via firebase-admin server-side and would bypass this
    // regardless, but the rule itself must independently hold since a
    // customer could otherwise reach any sale doc directly via the client
    // SDK by id). A sale with no customerUid (POS/offline, guest WhatsApp/
    // online orders) is readable by admin only, same as before.
    match /sales/{saleId} {
      allow read: if hasRole('admin') || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    // The account roster — no staff-facing feature needs to enumerate other
    // accounts, so this is admin-only (see stockMovements/sales above).
    match /users/{userId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // Storefront customer accounts — entirely separate from users/{uid}
    // (admin/staff) above. A customer may read AND write only their own doc
    // and its addresses subcollection, never another customer's — the
    // uid-equality check is the entire security boundary here, so it's
    // repeated at every nesting level rather than assumed to cascade
    // (Firestore rules don't inherit: a subcollection match block is
    // evaluated independently of its parent's). In practice, the app's own
    // UI still writes through /api/account/* (firebase-admin, server-side
    // uid from the verified session cookie, Zod-validated), same as every
    // other collection in this file — these rules are the actual security
    // boundary a raw/future direct-SDK write would still have to pass, not
    // just a UI-level restriction. A customer's Firebase Auth token carries
    // no role claim at all (see lib/firestore/types.ts's CustomerDoc), so
    // this is intentionally NOT gated by hasRole/isStaffOrAdmin for the
    // customer's own access — any signed-in user (customer or staff/admin)
    // may read/write their own customer doc, which is harmless since it's
    // just their own account. Admin ADDITIONALLY gets read access (not
    // write — every admin-initiated change still goes through firebase-
    // admin server routes) so Admin > Sales' linked-customer block and the
    // /admin/customers/[uid] profile page can read arbitrary customer docs
    // directly, same as sales/stockMovements/users above.
    match /customers/{uid} {
      allow read: if hasRole('admin') || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Bridges Razorpay order creation and payment verification, AND (a
    // second, later-added use of this same collection) a signed-in
    // customer's "Order on WhatsApp" draft awaiting admin review — see
    // PendingOrderDoc's source field. Writes only ever happen server-side
    // (firebase-admin) either way. Admin gets read access so Admin >
    // WhatsApp Orders' pending-drafts panel can live-query open drafts
    // directly (components/admin/whatsapp-orders/pending-drafts-panel.tsx),
    // same onSnapshot pattern as sales/stockMovements; a customer has no
    // direct read of their own drafts (the reference code in the WhatsApp
    // message is enough for staff to find it — no self-serve draft list).
    match /pendingOrders/{orderId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // Captured payments whose stock re-check failed at verification time;
    // only surfaced on Admin pages (admin-only, same reasoning as sales
    // above) so staff/refund processing needs admin to action it.
    match /refundFlags/{flagId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    // Public can read active homepage carousel banners; staff/admin can read
    // all (including inactive) for the admin panel. Writes go through
    // /api/admin/banners (firebase-admin, admin-only).
    match /banners/{bannerId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow write: if false;
    }

    // Admin-editable homepage content blocks (giftSection, ourStory,
    // announcementBar, importedSection, siteSettings) — non-sensitive
    // marketing copy, freely public-readable. Writes go through
    // /api/admin/site-content/* (admin-only).
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public can read active combo offers; staff/admin can read all
    // (including inactive/expired) for the admin panel. Writes go through
    // /api/admin/combos/* (firebase-admin, admin-only).
    match /combos/{comboId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
