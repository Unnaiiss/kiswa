    "test:checkout": "npx firebase-tools@latest emulators:exec --only firestore \"tsx scripts/test-checkout-stock-conflict.ts\"",
    "test:oil-report": "npx firebase-tools@latest emulators:exec --only firestore \"tsx scripts/test-oil-consumed-report.ts\"",
