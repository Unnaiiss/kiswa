# Firebase client SDK config (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only, NEVER expose to the client)
# Paste the full service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Razorpay (server-only, NEVER expose to the client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Master switch for online (Razorpay) checkout. Defaults to false — the
# storefront runs WhatsApp-only ordering with /checkout disabled and no
# Razorpay script loaded anywhere. Set to the literal string "true" (once
# Razorpay is ready to go live) to restore full online checkout with no
# other code changes.
#
# IMPORTANT — this is a NEXT_PUBLIC_ var, so Next.js inlines its value into
# the compiled JS at BUILD time, on both the client and server bundles.
# Setting/changing it in your hosting platform's dashboard (Vercel etc.) has
# NO effect until the next build — a restart or redeploy of an existing
# build will not pick it up. Make sure it's saved persistently against the
# Production environment (not applied as a one-off deploy override), then
# trigger a fresh build. Admin > Dashboard shows a live "Online payments:
# ON/OFF" indicator reading this exact constant, so you can confirm what a
# given deployment actually has baked in rather than guessing from the
# dashboard config.
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false

# Whether placing an order requires a signed-in customer account — defaults
# to TRUE (opposite default from the flag above) unless set to the literal
# string "false". Purely a front-end gate: browsing/search/product
# pages/the cart itself stay open to guests regardless; this only affects
# whether tapping Checkout/Buy Now/Order on WhatsApp prompts sign-in first
# (checkout itself always offers "Continue as guest" either way — see
# components/store/checkout-form.tsx — this flag is about the earlier
# product-page/cart-drawer taps, not whether guest checkout exists at all).
# Currently false: guest checkout is enabled. Set back to "true" (or unset)
# to require an account before ordering, with no other code changes.
NEXT_PUBLIC_REQUIRE_LOGIN_TO_ORDER=false

# WhatsApp ordering (safe to expose to the browser). Number is E.164 without
# the "+". Defaults to 919995778963 in code if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=919995778963
# Optional — used to build shareable product links in WhatsApp messages.
# Falls back to window.location.origin when unset.

# Meta (Facebook) Pixel — storefront routes only (components/store/
# meta-pixel.tsx never mounts on /admin or /pos, and skips itself on
# /account). Leave unset to skip loading the pixel entirely — no code
# changes needed, same NEXT_PUBLIC_ build-time-inlined pattern as the other
# flags in this file.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SITE_URL=

# Google Places Autocomplete for the "Address line 1" field on guest
# checkout and the saved-address form (lib/store/useAddressAutocomplete.ts).
# Leave unset to skip it entirely — the field just stays a plain text input,
# exactly as before this feature existed; no other code changes needed.
#
# To turn it on, in Google Cloud Console (the same project as your Firebase
# config above, or a separate one — either works):
#   1. Enable the "Maps JavaScript API" and "Places API" for the project.
#   2. Create an API key (or reuse one), then under "API restrictions"
#      limit it to exactly those two APIs.
#   3. Under "Application restrictions", set "HTTP referrers" to your
#      site's domain(s) (and localhost:3000 for local dev) — this key is
#      sent to the browser (NEXT_PUBLIC_), so referrer restriction is what
#      actually stops it being used from anywhere else, not secrecy.
#   4. Enable Billing on the project — the Places API has no free tier
#      without a billing account attached, even within the free monthly
#      credit.
# Do NOT reuse NEXT_PUBLIC_FIREBASE_API_KEY here unless you've deliberately
# enabled Maps JavaScript API + Places API on that same key and applied the
# referrer/API restrictions above to it — a key scoped only for Firebase
# Auth/Firestore won't have Maps access enabled by default.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
