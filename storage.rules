rules_version = '2';

// Deny-all is correct even though this bucket IS actively used (see
// lib/server/imageStorage.ts) — every read and write goes through
// firebase-admin, which bypasses these rules entirely (same principle as
// every Firestore write in this app): uploads happen server-side via the
// Admin SDK, and the public URL handed back embeds a per-object download
// token (Firebase's own getDownloadURL() mechanism) that grants read access
// directly, independent of these rules. Nothing — no client code, no admin
// page — ever talks to this bucket through the rules-governed path, so
// there is no legitimate access pattern these rules need to allow; keeping
// them deny-all means a bug can never accidentally turn this into an open
// read/write surface via the client SDK.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
